# Public, browser-safe configuration. Copy to .env.local for local development,
# or paste the same two values into Vercel → Project → Settings → Environment
# Variables (Production and Preview). Vite inlines them at build time, so a
# redeploy is required after changing them.
#
# Leave both blank to ship a guest-only build: games, local saves and the
# dashboard all keep working without a backend.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Never put a service-role key, Stripe secret, or DNS API token in this file.
# Server-only secrets belong in Supabase Edge Function secrets or CI secrets.
